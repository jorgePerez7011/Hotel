EMAIL_USER=solhotel.recepcion@gmail.com
EMAIL_PASSWORD=solhotel1234

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE=/var/log/hotel-app.log

# ==========================================
# SESIONES
# ==========================================
SESSION_SECRET=otro_secreto_largo_y_seguro_para_sesiones
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# CLOUDINARY (Opcional - para fotos)
# ==========================================
# CLOUDINARY_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

