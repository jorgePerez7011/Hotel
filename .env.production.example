# Configuración de Ejemplo para Producción
# Copiar este archivo a .env y llenar con tus valores reales

# ==========================================
# AMBIENTE
# ==========================================
NODE_ENV=production

# ==========================================
# SERVIDOR
# ==========================================
PORT=3000
API_URL=solhotel.co
FRONTEND_URL=https://solhotel.co/

# ==========================================
# BASE DE DATOS - OPCIÓN 1: MySQL (HOSTINGER)
# ==========================================
DB_TYPE=mysql
DB_HOST=srv1289.hstgr.io
DB_PORT=3306
DB_USER=u366343059_JorgePerez
DB_PASSWORD=1003175102Jorge
